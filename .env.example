# RapidCare environment variables
# The app runs fully in demo mode with none of these set.

# Routing provider: "mock" (default, no API key) | "ors" | "mapbox" | "google"
VITE_ROUTING_PROVIDER=mock

# Public map tile URL (OpenStreetMap by default). Respect the tile usage policy in production.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Supabase (production path). The anon key is safe for the browser ONLY because Row Level Security is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY — never prefix with VITE_ and never ship to the browser.
# Used by an edge function / proxy that calls the real routing provider.
ROUTING_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
